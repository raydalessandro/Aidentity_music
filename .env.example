# AIDENTITY — nomi delle variabili d'ambiente. Nessun valore, nemmeno finto.
# Copiare in `.env.local` (ignorato da git) e riempire in locale.
#
# Stripe: SOLO modalita' test. `STRIPE_SECRET_KEY` e' validata a runtime e
# deve essere una chiave di test; una chiave di produzione non viene accettata.

# --- Supabase -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Applicazione -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# --- Stripe (test mode) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price id dei sei acquistabili. L'annuale BASE e' il primo mostrato.
STRIPE_PRICE_BASE_YEAR=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_MAX_YEAR=
STRIPE_PRICE_BASE_MONTH=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_MAX_MONTH=
